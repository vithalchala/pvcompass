# Local Postgres connection string
DATABASE_URL=postgres://pvcompass:pvcompass@localhost:5432/pvcompass

# First user, created by `npm run db:seed` when there are no users yet
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Optional. At least 32 characters. Signs the session cookie.
# If unset, a key is derived from ADMIN_PASSWORD (changing the password logs everyone out).
SESSION_SECRET=
